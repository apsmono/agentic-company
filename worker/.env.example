# Supabase Project Credentials
SUPABASE_URL=https://your-project.supabase.co
# Can use service_role key for worker daemon (never exposed to browser)
# or anon key if RLS allows worker operations
SUPABASE_KEY=your_supabase_key_here

# Worker Process Configuration
WORKER_ID=mac-mini-worker-01
WORKER_CAPABILITIES=shell,echo,file_generator
POLL_INTERVAL_MS=3000
LEASE_DURATION_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=30
LOG_BATCH_INTERVAL_MS=1500
LOG_LEVEL=info
MAX_CONCURRENT_TASKS=1
